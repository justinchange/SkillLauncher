{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "skill-launcher",
  "title": "Skill Launcher",
  "description": "Quick launcher for Claude Code Skills - search and execute AI skills with real-time streaming output",
  "author": "skilllauncher",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "list-skills",
      "title": "List Skills",
      "subtitle": "Claude Code",
      "description": "Browse and execute Claude Code skills",
      "mode": "view"
    },
    {
      "name": "run-skill",
      "title": "Run Skill",
      "subtitle": "Claude Code",
      "description": "Quick run a skill with arguments",
      "mode": "view",
      "arguments": [
        {
          "name": "skillName",
          "placeholder": "Skill name",
          "type": "text",
          "required": false
        },
        {
          "name": "args",
          "placeholder": "Arguments",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
